# One server-only flag switches authentication, API state, and integrations.
DEMO_MODE=true

# Live mode: set DEMO_MODE=false and configure these values.
# Include the backend's API prefix in this URL. It is never exposed to the browser.
PORTAL_API_URL=http://localhost:3000/api
APP_VERSION=1.0.0
# Canonical public origin for share-preview URLs and reverse proxies, e.g. https://portal.example.com
# Set this for deployed environments; local previews default to http://localhost:3001.
PORTAL_APP_ORIGIN=
# Required in live mode: generate with `openssl rand -base64 48`.
SESSION_SECRET=
FIREBASE_WEB_API_KEY=

# Optional live Socket.IO server. Ticket endpoint is /realtime/tickets on the API.
PORTAL_SOCKET_URL=http://localhost:3000

# Optional Firebase Messaging. These Firebase web configuration values are public.
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_PUBLIC_KEY=

# Optional public analytics project key; SDK loads only after explicit consent.
AMPLITUDE_API_KEY=
